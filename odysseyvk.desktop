[Desktop Entry]
Type=Application
Version=1.0
Name=OdysseyVK
Name[es_MX]=OdysseyVK
GenericName=3D without glasses
GenericName[es_MX]=Visor 3D sin gafas
Comment=Settings and games of the Samsung Odyssey 3D hub
Comment[es_MX]=Ajustes y juegos del hub del Samsung Odyssey 3D
Exec=odysseyvk-panel
TryExec=odysseyvk
StartupWMClass=odysseyvk
Icon=odysseyvk
Terminal=false
Categories=AudioVideo;Video;
StartupNotify=false
Actions=juegos;play;taller;

[Desktop Action juegos]
Name=Games
Name[es_MX]=Juegos
Exec=odysseyvk-panel --juegos

[Desktop Action play]
Name=Play a file in 3D
Name[es_MX]=Reproducir un archivo en 3D
Exec=odysseyvk play %f

[Desktop Action taller]
Name=Workshop settings
Name[es_MX]=Ajustes de taller
Exec=odysseyvk-ajustes
