[Unit]
Description=OdysseyVK: vigilante de ventanas a pantalla completa
Documentation=https://github.com/Fulviuus/macdissey-3d
# Arranca con la sesión gráfica del usuario (KDE Plasma usa graphical-session.target).
PartOf=graphical-session.target
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# El servicio sólo mira ventanas y manda avisos: el 3D lo arranca en un proceso
# aparte (@BINDIR@ capture3d) que ya se enciende la lente, el scaler y el panel.
ExecStart=@BINDIR@/odysseyvk serve
Restart=on-failure
RestartSec=4
# Sin volcado de memoria. El visor es hijo de este servicio: cuando reventaba, systemd-coredump
# se ponía a recoger un core de 300 MB y recién después waitpid le avisaba al hub de que el hijo
# había muerto. Medido el 23-nov: 22 segundos con el monitor en modo 3D y nadie dibujando nada.
# La pila del fallo la imprime igual el manejador del visor, así que no perdemos el diagnóstico.
LimitCORE=0
# El binario adivina WAYLAND_DISPLAY escaneando $XDG_RUNTIME_DIR, así que la unidad
# no necesita exportarlo.

[Install]
WantedBy=graphical-session.target
