# Samsung Odyssey 3D (G90XF): lente lenticular, scaler MediaTek y camara de seguimiento.
# Lente lenticular (CDC-ACM, 354b:0116)
SUBSYSTEM=="tty", ATTRS{idVendor}=="354b", ATTRS{idProduct}=="0116", MODE="0660", GROUP="uucp", TAG+="uaccess", TAG+="odysseyvk"
# Scaler del panel (dispositivo SCSI vendor GCREADER, /dev/sgN)
SUBSYSTEM=="scsi_generic", SUBSYSTEMS=="scsi", ATTRS{vendor}=="GCREADER*", MODE="0660", TAG+="uaccess", TAG+="odysseyvk"
SUBSYSTEM=="bsg", SUBSYSTEMS=="scsi", ATTRS{vendor}=="GCREADER*", MODE="0660", TAG+="uaccess"
# Camara estereo IR (04e8:20d7)
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="04e8", ATTRS{idProduct}=="20d7", MODE="0660", GROUP="video", TAG+="uaccess"
# Autosuspension: la camara y la lente cuelgan de los hubs del cable del monitor. Si el
# kernel suspende la camara (retardo de 2 s) el resume no siempre llega y su interfaz de
# streaming deja de contestar a los controles UVC: en dmesg queda
# "Failed to set UVC probe control : -110" y VIDIOC_S_FMT devuelve EIO. Con el
# dispositivo siempre despierto los hubs de en medio tampoco se suspenden.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04e8", ATTR{idProduct}=="20d7", ATTR{power/control}="on"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="354b", ATTR{idProduct}=="0116", ATTR{power/control}="on"
